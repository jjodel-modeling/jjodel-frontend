{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "cleanupPeriodDays": 3650,
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm start)",
      "Bash(npm test*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(node frontend/scripts/run-quiet.mjs *)",
      "Bash(node scripts/run-quiet.mjs *)"
    ],
    "ask": [
      "Bash(git push*)"
    ],
    "deny": [
      "Bash(git add .)",
      "Bash(git add -A*)",
      "Bash(rm -rf*)",
      "Bash(git stash *)",
      "Bash(git stash)",
      "Bash(git add --all*)",
      "Bash(git add -u*)",
      "Bash(* --no-verify*)",
      "Bash(git checkout HEAD -- .)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git restore --staged .)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/frontend/scripts/hooks/bash-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/frontend/scripts/hooks/output-budget.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/frontend/scripts/hooks/critical-zone.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/frontend/scripts/hooks/rule-trigger.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/frontend/scripts/hooks/context-ceiling.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "JJODEL_LIGHT_MODEL": "claude-sonnet-5-5",
    "JJODEL_REPORT_MODEL": "claude-haiku-5-5"
  }
}