{
  "about": "Golden rows for JjEL bit-vectors (R-BV, slice S1). Expected values are hand-computed from the cited clause; the Verilator oracle of the case table is the later S-oracle step. 'bv' is the expected Verilog form of a vector result, 'value' a plain expected value. A row with 'method' replaces the method name 'M' of the top-level call, for the methods whose names are JjEL keywords and do not parse after '.'. Sections are of IEEE 1800-2017.",
  "rows": [
    { "id": "add-wrap",        "expr": "bits(8, 255) + bits(8, 1)", "bv": "8'h00", "source": "11.4.3, 11.6.1: the sum is max(L(i), L(j)) = 8 bits wide, the carry is lost" },
    { "id": "add",             "expr": "bits(8, 100) + bits(8, 27)", "bv": "8'h7f", "source": "11.4.3" },
    { "id": "sub-wrap",        "expr": "bits(8, 0) - bits(8, 1)", "bv": "8'hff", "source": "11.4.3, 11.6.1: modulo 2^8" },
    { "id": "sub",             "expr": "bits(8, 5) - bits(8, 3)", "bv": "8'h02", "source": "11.4.3" },
    { "id": "sub-reversed",    "expr": "bits(8, 3) - bits(8, 5)", "bv": "8'hfe", "source": "11.4.3, 11.6.1: -2 modulo 2^8" },
    { "id": "mul-wrap",        "expr": "bits(8, 16) * bits(8, 16)", "bv": "8'h00", "source": "11.4.3, 11.6.1: 256 modulo 2^8" },
    { "id": "mul",             "expr": "bits(8, 20) * bits(8, 13)", "bv": "8'h04", "source": "11.4.3, 11.6.1: 260 modulo 2^8" },
    { "id": "mul-signed",      "expr": "sbits(8, -3) * sbits(8, 5)", "bv": "8'shf1", "source": "11.4.3.1: signed operands, -15 in two's complement" },
    { "id": "neg",             "expr": "-bits(8, 1)", "bv": "8'hff", "source": "11.4.3: unary minus, two's complement" },
    { "id": "neg-min",         "expr": "-sbits(8, -128)", "bv": "8'sh80", "source": "11.4.3: -(-128) modulo 2^8 is -128" },
    { "id": "lt-signed",       "expr": "sbits(8, '0x80') < sbits(8, 1)", "value": true, "source": "11.4.4, 11.8.1: both operands signed, -128 < 1" },
    { "id": "gt-unsigned",     "expr": "bits(8, '0x80') > bits(8, 1)", "value": true, "source": "11.4.4: unsigned, 128 > 1" },
    { "id": "ge-signed",       "expr": "sbits(8, -1) >= sbits(8, 0)", "value": false, "source": "11.4.4, 11.8.1: -1 < 0" },
    { "id": "le-unsigned",     "expr": "bits(8, 255) <= bits(8, 0)", "value": false, "source": "11.4.4" },
    { "id": "eq",              "expr": "bits(8, 255) == bits(8, '0xff')", "value": true, "source": "11.4.5" },
    { "id": "ne",              "expr": "bits(8, 1) != bits(8, 2)", "value": true, "source": "11.4.5" },
    { "id": "slice-high",      "expr": "bits(8, '0xab').slice(7, 4)", "bv": "4'ha", "source": "11.5.1: part-select x[7:4]" },
    { "id": "slice-low",       "expr": "bits(8, '0xab').slice(3, 0)", "bv": "4'hb", "source": "11.5.1: part-select x[3:0]" },
    { "id": "bit-0",           "expr": "bits(8, '0xab').bit(0)", "bv": "1'h1", "source": "11.5.1: bit-select x[0] of 1010_1011" },
    { "id": "bit-2",           "expr": "bits(8, '0xab').bit(2)", "bv": "1'h0", "source": "11.5.1: bit-select x[2] of 1010_1011" },
    { "id": "concat",          "expr": "bits(4, '0xa').concat(bits(4, '0xb'))", "bv": "8'hab", "source": "11.4.12: {4'ha, 4'hb}, first operand most significant" },
    { "id": "concat-3",        "expr": "bits(1, 1).concat(bits(2, 0), bits(1, 1))", "bv": "4'h9", "source": "11.4.12: {1'b1, 2'b00, 1'b1} = 4'b1001" },
    { "id": "replicate",       "expr": "bits(2, '0b10').replicate(3)", "bv": "6'h2a", "source": "11.4.12.1: {3{2'b10}} = 6'b101010" },
    { "id": "zext",            "expr": "bits(4, '0b1000').zext(8)", "bv": "8'h08", "source": "10.7: an unsigned value is extended with zeros" },
    { "id": "sext-4",          "expr": "bits(4, '0b1000').sext(8)", "bv": "8'hf8", "source": "11.8.2: sign extension, as $signed(4'b1000) assigned to 8 bits; sext copies the top bit whatever the signedness" },
    { "id": "sext-1",          "expr": "bits(1, 1).sext(8)", "bv": "8'hff", "source": "11.8.2: sign extension of 1'b1" },
    { "id": "sext-positive",   "expr": "sbits(4, 3).sext(8)", "bv": "8'sh03", "source": "11.8.2: sign extension of a positive value" },
    { "id": "trunc",           "expr": "bits(16, '0x1234').trunc(8)", "bv": "8'h34", "source": "10.7: truncation keeps the least significant bits" },
    { "id": "xor",             "expr": "bits(8, '0xcc').xor(bits(8, '0xaa'))", "bv": "8'h66", "source": "11.4.8: 8'hcc ^ 8'haa" },
    { "id": "and",             "expr": "bits(8, '0xcc').M(bits(8, '0xaa'))", "method": "and", "bv": "8'h88", "source": "11.4.8: 8'hcc & 8'haa" },
    { "id": "or",              "expr": "bits(8, '0xcc').M(bits(8, '0xaa'))", "method": "or", "bv": "8'hee", "source": "11.4.8: 8'hcc | 8'haa" },
    { "id": "not",             "expr": "bits(8, '0xcc').M()", "method": "not", "bv": "8'h33", "source": "11.4.8: ~8'hcc" },
    { "id": "shl",             "expr": "bits(8, '0x81').shl(1)", "bv": "8'h02", "source": "11.4.10: 8'h81 << 1, vacated bits zero" },
    { "id": "shr",             "expr": "bits(8, '0x81').shr(1)", "bv": "8'h40", "source": "11.4.10: 8'h81 >> 1, vacated bits zero" },
    { "id": "ashr-signed",     "expr": "sbits(8, '0x80').ashr(1)", "bv": "8'shc0", "source": "11.4.10: >>> on a signed operand fills with the sign bit" },
    { "id": "shl-by-width",    "expr": "bits(8, '0xff').shl(8)", "bv": "8'h00", "source": "11.4.10: every bit shifted out, vacated bits zero" },
    { "id": "ashr-beyond",     "expr": "sbits(8, -2).ashr(100)", "bv": "8'shff", "source": "11.4.10: every vacated bit is the sign bit" },
    { "id": "as-signed",       "expr": "bits(8, 255).asSigned().toNumber()", "value": -1, "source": "11.7: $signed(8'hff) is -1" },
    { "id": "as-unsigned",     "expr": "sbits(8, -1).asUnsigned().toNumber()", "value": 255, "source": "11.7: $unsigned(8'shff) is 255" },
    { "id": "w1-add",          "expr": "bits(1, 1) + bits(1, 1)", "bv": "1'h0", "source": "11.4.3, 11.6.1: modulo 2^1" },
    { "id": "w53-add",         "expr": "bits(53, 9007199254740991) + bits(53, 1)", "bv": "53'h00000000000000", "source": "11.6.1: (2^53-1) + 1 modulo 2^53" },
    { "id": "w53-to-number",   "expr": "bits(53, 9007199254740991).toNumber()", "value": 9007199254740991, "source": "the largest safe integer, 2^53-1" },
    { "id": "w54-add",         "expr": "bits(54, '9007199254740992') + bits(54, 1)", "bv": "54'h20000000000001", "source": "11.6.1: 2^53 + 1 is exact at 54 bits" },
    { "id": "w64-add",         "expr": "bits(64, '0xffffffffffffffff') + bits(64, 1)", "bv": "64'h0000000000000000", "source": "11.6.1: (2^64-1) + 1 modulo 2^64" },
    { "id": "w64-lt-signed",   "expr": "sbits(64, '0x8000000000000000') < sbits(64, 0)", "value": true, "source": "11.4.4, 11.8.1: -2^63 < 0" },
    { "id": "w65-add",         "expr": "bits(64, '0xffffffffffffffff').zext(65) + bits(65, 1)", "bv": "65'h10000000000000000", "source": "10.7, 11.6.1: the carry fits at 65 bits" },
    { "id": "w128-mul",        "expr": "bits(128, '0xffffffffffffffffffffffffffffffff') * bits(128, '0xffffffffffffffffffffffffffffffff')", "bv": "128'h00000000000000000000000000000001", "source": "11.6.1: (2^128-1)^2 modulo 2^128 is 1" },
    { "id": "w128-ashr",       "expr": "sbits(128, '0x80000000000000000000000000000000').ashr(127)", "bv": "128'shffffffffffffffffffffffffffffffff", "source": "11.4.10: the sign bit fills every vacated position" }
  ]
}
