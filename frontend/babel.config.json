{
  "comments": true,
  "presets": ["@babel/preset-env"],
  "plugins": [
    "@babel/plugin-proposal-nullish-coalescing-operator",
    "@babel/plugin-transform-class-static-block"
  ],
  "env":
  {
    "development": {
      "presets": [
        ["@babel/preset-env", {"builtIns": false}]
    ]},
    "production": {
      "presets": [
        ["@babel/preset-env", {"builtIns": false}]
    ]}
  }
}
