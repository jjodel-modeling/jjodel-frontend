{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lane Monitor",
  "version": "0.1.0",
  "identifier": "io.jjodel.lane-monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Menu bar monitor for the Jjodel lane board",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
