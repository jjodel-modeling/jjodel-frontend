{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat >> /tmp/userpromptsubmit-probe.log; echo >> /tmp/userpromptsubmit-probe.log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat >> /tmp/userpromptsubmit-probe.log; echo >> /tmp/userpromptsubmit-probe.log"
          }
        ]
      }
    ]
  }
}
